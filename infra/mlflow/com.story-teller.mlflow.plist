<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the MLflow server; setup.sh fills in __DIR__ and installs it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.story-teller.mlflow</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__DIR__/run.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Retry every 60 s while the drive or Postgres is unavailable. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__DIR__/mlflow.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/mlflow.log</string>
</dict>
</plist>
