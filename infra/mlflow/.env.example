# Copy to .env on the MLflow host and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 24
POSTGRES_PASSWORD=
MLFLOW_ADMIN_PASSWORD=
MLFLOW_SECRET_KEY=
# Tailscale address of the host; MLflow listens only there.
TAILSCALE_IP=100.123.117.116
# Artifact storage (models, adapters, result files). Internal disk for now; see README.md for
# why the external drive does not work yet.
ARTIFACT_DIR=/Users/tannguyen/mlflow/artifacts
